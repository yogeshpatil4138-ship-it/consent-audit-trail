# === Database ===
POSTGRES_DB=consent_audit
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# === JWT (use at least 32 random chars) ===
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRATION_MS=3600000

# === Groq AI (free tier: https://console.groq.com) ===
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# === Mail (optional; Gmail app password recommended) ===
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# === Seed 30 demo records on startup ===
SEED_DATA=true

# === Frontend build-time API URL ===
VITE_API_BASE_URL=http://localhost:8080
